      {"sequence": 1, "actor": "customer", "kind": "speech_end", "content": "My camera stopped working after I changed Wi-Fi on Friday, not Thursday. The account is A-204.", "data": {"end_ms": 1000, "entities": {"account_id": "A-204", "incident_date": "Friday"}, "negations": ["not Thursday"]}},
